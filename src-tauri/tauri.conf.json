{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "Aether Mean",
    "version": "0.1.4"
  },
  "build": {
    "beforeDevCommand": "npm --prefix frontend run start",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "devPath": "http://127.0.0.1:4200",
    "distDir": "../frontend-dist"
  },
  "tauri": {
    "windows": [
      {
        "title": "Aether Mean",
        "width": 1280,
        "height": 820,
        "resizable": true
      }
    ],
    "bundle": {
      "active": true,
      "identifier": "com.gs2k.aethermean",
      "targets": "all",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    }
  }
}
